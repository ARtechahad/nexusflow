# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection URI (e.g., postgresql://postgres:password@host:5432/railway or Supabase/Neon)
DATABASE_URL=

# STRIPE_SECRET_KEY: Live/Test Stripe secret API key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Signing secret for live Stripe webhook verification (whsec_...)
STRIPE_WEBHOOK_SECRET=

# UPWORK_WEBHOOK_SECRET: Secret token for Upwork webhook validation
UPWORK_WEBHOOK_SECRET=

# JWT_SECRET: Secret key for signing and verifying JWT session tokens
JWT_SECRET=

# GTM & Outbound Tools Integrations (Optional - falls back to Gemini & built-in heuristic verification engines)
# HUNTER_API_KEY: Hunter.io API key for domain email pattern search
HUNTER_API_KEY=

# APOLLO_API_KEY: Apollo.io API key for organization & contact enrichment
APOLLO_API_KEY=

# OPENAI_API_KEY: OpenAI API key (for gpt-4o-mini spam check & hook generation)
OPENAI_API_KEY=

# GEMINI_MODEL: Default Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ENCRYPTION_KEY: 32-byte AES-256 encryption key (base64 encoded) for mailbox passwords & OAuth tokens
# Example generated via: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# OUTREACH_WORKER: Controls outreach background worker loop ('on' or 'off', defaults to 'on')
OUTREACH_WORKER=on
