# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEON DATABASE (Serverless PostgreSQL):
# Connection URI from your Neon console (https://console.neon.tech).
# Supports SSL automatically (sslmode=require).
# Example: postgresql://neondb_owner:npg_secret@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
NEON_DATABASE_URL=

# CLERK AUTHENTICATION:
# Obtain your API keys from the Clerk Dashboard (https://dashboard.clerk.com -> API Keys).
# 1. CLERK_SECRET_KEY: Used by the Node.js / Express backend to authenticate sessions and JWTs.
CLERK_SECRET_KEY=
# 2. CLERK_PUBLISHABLE_KEY / VITE_CLERK_PUBLISHABLE_KEY: Used by the React frontend (@clerk/clerk-react).
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# 3. CLERK_WEBHOOK_SECRET: Signing secret (whsec_...) from Clerk Webhooks for syncing user.created/updated to Neon DB.
CLERK_WEBHOOK_SECRET=

# STRIPE_SECRET_KEY: Live/Test Stripe secret API key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Signing secret for live Stripe webhook verification (whsec_...)
STRIPE_WEBHOOK_SECRET=

# UPWORK_WEBHOOK_SECRET: Secret token for Upwork webhook validation
UPWORK_WEBHOOK_SECRET=

# JWT_SECRET: Secret key for signing and verifying JWT session tokens
JWT_SECRET=

# GTM & Outbound Tools Integrations (Optional - falls back to Gemini & built-in heuristic verification engines)
# HUNTER_API_KEY: Hunter.io API key for domain email pattern search
HUNTER_API_KEY=

# APOLLO_API_KEY: Apollo.io API key for organization & contact enrichment
APOLLO_API_KEY=

# OPENAI_API_KEY: OpenAI API key (for gpt-4o-mini spam check & hook generation)
OPENAI_API_KEY=

# GEMINI_MODEL: Default Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ENCRYPTION_KEY: 32-byte AES-256 encryption key (base64 encoded) for mailbox passwords & OAuth tokens
# Example generated via: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# RESEND EMAIL ENGINE:
# Primary and exclusive email dispatch engine for outreach campaigns, replies, notifications & sequences
# API Key from https://resend.com/api-keys
RESEND_API_KEY=re_LXiiEzAS_86mprrkSQfUGaJHZRK25Pp18
# Default verified sender address or Resend onboarding sandbox address
EMAIL_FROM_ADDRESS=ALM Nexus <onboarding@resend.dev>

# OUTREACH_WORKER: Controls outreach background worker loop ('on' or 'off', defaults to 'on')
OUTREACH_WORKER=on
